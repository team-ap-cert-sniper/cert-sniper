# 이 파일을 복사해 application-local.yml 로 저장한 뒤 값을 채운다. (커밋 금지)
spring:
  datasource:
    url: jdbc:mysql://localhost:3307/cert_sniper?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
    username: cert_app
    password: DB_APP_PASSWORD
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
  mail:
    username: SMTP_ACCOUNT@gmail.com
    password: GMAIL_APP_PASSWORD

app:
  jwt:
    secret: JWT_SECRET_32_CHARS_OR_MORE
  ai:
    model: qwen2.5:14b           # 로컬 Ollama 모델명
