# cp .env.example .env 로 복사해서 씁니다. (.env는 커밋 금지)
# 아래 DB·JWT 값은 각자 노트북 개발 DB 전용 기본값입니다. 운영 서버에서는 반드시 바꿉니다.

DB_ROOT_PASSWORD=certroot1234
DB_MIGRATOR_PASSWORD=certmigrator1234
DB_APP_PASSWORD=certapp1234
DB_PORT=3307

JWT_SECRET=cert-sniper-local-dev-jwt-secret-key-2026

# 인증 메일 발신 계정 (팀 프로젝트용 Gmail과 앱 비밀번호, 카톡으로 받아서 채움. 비우면 인증 메일만 안 감)
MAIL_USERNAME=
MAIL_PASSWORD=
